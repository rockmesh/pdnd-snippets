        ],
        "summary": "Recupero elenco esiti",
        "description": "Recupera una lista di esiti appartenenti all'ente chiamante per una specifica finalità a partire dall'offset.Restituisce un massimo di 'size' esiti con offset maggiore di quello specificato in input. Gli offset sono numeri interi progressivi senza dicontinuità.",
        "operationId": "poll",
        "parameters": [
          {
            "$ref": "#/components/parameters/Agid-JWT-TrackingEvidence"
          },
          {
            "$ref": "#/components/parameters/Agid-JWT-Signature"
          },
          {
            "$ref": "#/components/parameters/Digest"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset di partenza per il recupero degli esiti",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 9223372036854776000,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Numero massimo di elementi da restituire",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
