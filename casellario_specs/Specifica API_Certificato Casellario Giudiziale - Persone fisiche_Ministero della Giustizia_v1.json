          "type": "string",
          "minLength": 5,
          "maxLength": 8192,
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
        }
      },
      "Agid-JWT-Signature": {
        "name": "Agid-JWT-Signature",
        "in": "header",
        "required": true,
        "description": "Firma JWS ModI/PDND del messaggio.",
